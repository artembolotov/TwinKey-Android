<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".TwinKeyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TwinKey">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TwinKey.Splash"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Открытие .twinkey бэкапов из файлового менеджера / "Открыть с помощью".

                 Ключевой фильтр: у .twinkey нет зарегистрированного MIME-типа, поэтому
                 DocumentsProvider/MediaStore отдают такой файл как application/octet-stream.
                 Фильтры по имени файла (pathPattern, ниже) тут не работают: у content://
                 URI большинства провайдеров в пути вообще нет имени файла — там
                 непрозрачный id вроде content://com.android.providers.downloads.documents/
                 document/msf%3A1000000042. Именно поэтому система и отвечала "нет
                 приложений, способных открыть файл этого типа": совпасть было не по чему.
                 Матчимся по MIME-типу без ограничений на путь — иначе открыть бэкап из
                 "Загрузок" или Google Files невозможно в принципе.

                 android:scheme здесь НЕ объявляем намеренно. Проводники (Samsung My Files
                 и др.) и механизм package visibility на Android 11+ проверяют "есть ли чем
                 открыть файл" через Intent с типом, но БЕЗ data URI —
                 new Intent(ACTION_VIEW).setType(mime). В IntentFilter#matchData объявленная
                 схема отсекает такой Intent сразу (scheme == null сравнивается с "" и не
                 совпадает с "content"), поэтому проводник показывает "нет приложений", даже
                 не дойдя до настоящего резолвинга. Без объявленной схемы срабатывает
                 задокументированный в AOSP special case: фильтр с одними лишь типами ловит
                 и Intent'ы без data URI, и content://, и file://. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-twinkey" />
                <data android:mimeType="application/vnd.twinkey" />
            </intent-filter>

            <!-- Дополнительный фильтр по расширению — для провайдеров, которые всё же
                 отдают имя файла в пути (ExternalStorageProvider: /document/primary:
                 Download/backup.twinkey) и при этом ставят нестандартный MIME-тип,
                 не покрытый фильтром выше.

                 android:host обязателен: IntentFilter#matchData проверяет пути только
                 когда у фильтра объявлен authority, без него pathPattern молча
                 игнорируется и фильтр начинает ловить вообще все content:// URI.
                 pathAdvancedPattern (API 26+, minSdk у нас 26) — настоящая регулярка,
                 в отличие от pathPattern, чей PatternMatcher.SIMPLE_GLOB не умеет
                 бэктрекинг и спотыкается об имена с несколькими точками; pathPattern
                 оставлен для совместимости с резолверами, игнорирующими advanced. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.twinkey" />
                <data android:pathAdvancedPattern=".*\\.twinkey" />
            </intent-filter>

            <!-- То же самое, но без android:mimeType — ловит Intent'ы вовсе без MIME-типа
                 (type == null). Некоторые файловые менеджеры для незнакомого расширения не
                 выставляют тип совсем, а фильтр с объявленным mimeType такие Intent'ы
                 принципиально не матчит (IntentFilter#findMimeType возвращает false для
                 null-типа ещё до проверки "*/*"), поэтому нужен отдельный фильтр. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.twinkey" />
                <data android:pathAdvancedPattern=".*\\.twinkey" />
            </intent-filter>

            <!-- Запасной путь: "Поделиться → TwinKey" из файлового менеджера. Работает даже
                 там, где "Открыть с помощью" для неизвестного расширения не предлагается
                 вовсе. Uri приходит в EXTRA_STREAM, см. MainActivity.handleFileIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-twinkey" />
                <data android:mimeType="application/vnd.twinkey" />
            </intent-filter>
        </activity>
    </application>

</manifest>