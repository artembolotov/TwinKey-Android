<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа для API 30 и ниже (на API 31+ действует data_extraction_rules.xml).
   См. https://developer.android.com/guide/topics/data/autobackup

   Только exclude: всё остальное бэкапится по умолчанию, как и раньше.
-->
<full-backup-content>
    <!--
      Зашифрованное хранилище аккаунтов (EncryptedSharedPreferences). Ключ шифрования
      лежит в Android Keystore и неэкспортируем by design, поэтому на новом устройстве
      восстановленный файл расшифровать нечем: он не просто бесполезен, а приводит к
      нерасшифровываемому состоянию, которое приходится сносить на старте (см.
      data/KeychainService.kt). Переносить аккаунты нужно через .twinkey-файл.
    -->
    <exclude domain="sharedpref" path="ru.artembolotov.twinkey.otp.xml"/>
</full-backup-content>
