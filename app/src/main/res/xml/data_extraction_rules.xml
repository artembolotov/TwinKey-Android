<?xml version="1.0" encoding="utf-8"?><!--
   Правила бэкапа и переноса на устройство для API 31+.
   См. https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Только exclude: всё остальное бэкапится и переносится по умолчанию, как и раньше.
   Зашифрованное хранилище аккаунтов исключено из обеих секций — master key из Android
   Keystore не покидает устройство, поэтому восстановленный файл расшифровать нечем
   (подробнее в data/KeychainService.kt). Аккаунты переносятся .twinkey-файлом.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ru.artembolotov.twinkey.otp.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ru.artembolotov.twinkey.otp.xml"/>
    </device-transfer>
</data-extraction-rules>
