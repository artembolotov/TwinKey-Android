<?xml version="1.0" encoding="utf-8"?>
<!--
  haze_noise — единственный ресурс, который поставляет Haze. Ссылка на него живёт
  только внутри библиотеки (dev.chrisbanes.haze.R.drawable.haze_noise в
  getNoiseTexture()), в коде и разметке приложения его нет, поэтому усушка ресурсов
  (isShrinkResources) считает его неиспользуемым. Если ресурс не читается,
  BitmapFactory.decodeResource глотает исключение и возвращает null, а объявленный
  в Haze non-null тип превращает это в NPE прямо в фазе отрисовки.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/haze_noise" />
